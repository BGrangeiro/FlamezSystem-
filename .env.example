# Desenvolvimento: basta npm start. Para publicar, use production e preencha tudo.
NODE_ENV=development
HOST=127.0.0.1
PORT=5177

# Caminho absoluto fora de public e da pasta substituída em cada deploy.
# Linux/VPS: /var/lib/flamez
# Windows: C:/FlamezData
DATA_DIR=
APP_ORIGIN=

# Gere uma senha e seu hash com npm run credentials. Nunca publique a senha/hash.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=

# Autoriza entrada automática após o quarto login correto pelo mesmo IP.
AUTO_LOGIN_BY_IP=true
# Só preencha quando houver proxy reverso controlado (ex.: Nginx local).
# O último IP de X-Forwarded-For deve ser acrescentado pelo proxy, nunca pelo cliente.
TRUSTED_PROXY_IPS=

# Em desenvolvimento, vazio mantém a senha atual 1234. Obrigatório em produção.
PRODUCTION_DELETE_PASSWORD=
# Opcional: destino das cópias (com servidor parado).
BACKUP_DIR=
