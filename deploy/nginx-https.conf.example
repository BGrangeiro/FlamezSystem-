# Use apenas depois de emitir o certificado e substituir todos os domínios/caminhos.
server {
    listen 80;
    server_name sistema.seudominio.com;
    return 301 https://sistema.seudominio.com$request_uri;
}
server {
    listen 443 ssl;
    server_name sistema.seudominio.com;
    ssl_certificate /etc/letsencrypt/live/sistema.seudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sistema.seudominio.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4m;
    location / {
        proxy_pass http://127.0.0.1:5177;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 35s;
    }
}
