# Substitua sistema.seudominio.com; habilite HTTPS antes do primeiro acesso.
# Este bloco HTTP pode ser convertido pelo Certbot para redirecionar a HTTPS.
server {
    listen 80;
    server_name sistema.seudominio.com;
    client_max_body_size 4m;
    location / {
        proxy_pass http://127.0.0.1:5177;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 35s;
    }
}
